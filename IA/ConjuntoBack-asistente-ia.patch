+package com.example.APP.Service;
+
+import com.example.APP.IA.HerramientasIA;
+import com.example.APP.IA.LlmClient;
+import com.example.APP.IA.LlmClient.MensajeLlm;
+import com.example.APP.IA.TextoIA;
